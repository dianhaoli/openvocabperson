# Copy to .env (read by the server, the CLI and docker compose). Every variable is optional.
# Full reference: README.md → Configuration.

# ── storage ──────────────────────────────────────────────────────────────────
# Local runs; docker compose sets its own DATABASE_URL and container paths.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vision_analysis
# OVP_STORAGE_DIR=storage
# OVP_WEIGHTS_DIR=.
# OVP_DEVICE=auto                # auto | cpu | cuda | cuda:1 | mps

# ── cloud providers (any one enables VLM descriptions, query expansion and the agent) ──
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=                # GOOGLE_API_KEY is accepted too
# OPENROUTER_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OLLAMA_BASE_URL=http://localhost:11434/v1
# Any OpenAI-compatible server (vLLM, LM Studio, TGI, llama.cpp ...) → spec "compat:<model>"
# OVP_COMPAT_BASE_URL=http://localhost:8001/v1
# OVP_COMPAT_API_KEY=

# ── models: provider:model specs, "auto" picks the best available, "none" disables ──
# OVP_DETECTOR=auto              # yoloe:yoloe-11s-seg.pt is a good choice on CPU
# OVP_SEGMENTER=auto             # sam:sam2.1_b.pt | sam:mobile_sam.pt | fastsam:FastSAM-s.pt | detector
# OVP_VLM=auto                   # openai:gpt-4.1-mini | anthropic:claude-haiku-5-5 | gemini:gemini-2.5-flash | qwen:Qwen/Qwen2.5-VL-3B-Instruct | ollama:qwen2.5vl:7b
# OVP_LLM=auto                   # planner + agent; must support tool calling for the agent
# OVP_EMBEDDER=auto              # clip:ViT-B-32
# OVP_TEXT_EMBEDDER=auto         # openai:text-embedding-3-small | gemini:gemini-embedding-001 | st:all-MiniLM-L6-v2 | ollama:nomic-embed-text | clip
# OVP_REID=auto                  # osnet:osnet_x1_0 | clip | color

# default model names used by "auto" and by specs without a model
# OVP_OPENAI_VLM_MODEL=gpt-4.1-mini
# OVP_OPENAI_LLM_MODEL=gpt-4.1-mini
# OVP_ANTHROPIC_VLM_MODEL=claude-haiku-5-5
# OVP_ANTHROPIC_LLM_MODEL=claude-sonnet-5-5
# OVP_GEMINI_MODEL=gemini-2.5-flash
# OVP_LOCAL_VLM_MODEL=Qwen/Qwen2.5-VL-3B-Instruct

# ── detection / segmentation ─────────────────────────────────────────────────
# OVP_CONF=0.25
# OVP_LOW_CONF=0.3
# OVP_NMS_IOU=0.7
# OVP_EXPAND_RATIO=0.1
# OVP_MAX_DETECTIONS=100

# ── VLM ──────────────────────────────────────────────────────────────────────
# OVP_VLM_CONCURRENCY=8
# OVP_VLM_BATCH=4
# OVP_VLM_MAX_TOKENS=260
# OVP_MAX_VLM_CROPS=40
# OVP_VLM_QUANT=none             # none | 8bit | 4bit (local Qwen-VL on CUDA)
# OVP_REQUEST_TIMEOUT=90

# ── video ────────────────────────────────────────────────────────────────────
# OVP_VIDEO_FPS=2
# OVP_MAX_FRAMES=600
# OVP_MIN_TRACK_HITS=2

# ── jobs ─────────────────────────────────────────────────────────────────────
# OVP_JOB_CONCURRENCY=2
# OVP_MEDIA_CONCURRENCY=3

# ── identity (defaults depend on the Re-ID backend) ──────────────────────────
# OVP_REID_MATCH=
# OVP_REID_REVIEW=

# ── misc ─────────────────────────────────────────────────────────────────────
# OVP_PRELOAD=true               # load default models in the background at startup
# OVP_FRONTEND_DIST=frontend/dist
